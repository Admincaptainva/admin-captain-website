# Secrets for the notify-lead Edge Function.
# These run on Supabase's servers — NEVER put them in the root .env or prefix them with VITE_,
# because anything starting with VITE_ is bundled into the public website.
#
# Production: Supabase Dashboard → Edge Functions → Secrets (or `supabase secrets set --env-file supabase/functions/.env`)
# Local dev:  copy this file to supabase/functions/.env and run `supabase functions serve notify-lead`

# From https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ↓↓↓ YOUR DESTINATION INBOX — new-lead emails are sent here (comma-separate for more than one) ↓↓↓
NOTIFICATION_EMAIL=you@yourdomain.com

# Optional. Leave unset to use Resend's test sender (onboarding@resend.dev), which can ONLY deliver
# to the email address you signed up to Resend with. Once you verify admincaptainva.com in Resend,
# set this so you can deliver to any inbox:
# NOTIFICATION_FROM=AdminCaptainVA Leads <leads@admincaptainva.com>
